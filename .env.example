# FinTrack — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to git — only commit .env.example
#
# ─── Vite / Frontend ─────────────────────────────────────────────────────────
# No VITE_ variables required for the default setup.
# The Vite dev server proxies /api → http://localhost:8787 automatically.

# ─── Worker secrets (set via wrangler for production) ────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# For local dev: set JWT_SECRET in wrangler.toml under [vars]
# For production: wrangler secret put JWT_SECRET

# ─── Cloudflare Resource IDs (fill into wrangler.toml, not here) ─────────────
# D1_DATABASE_ID=your-d1-database-id-from-wrangler-d1-create
# R2_BUCKET_NAME=fintrack-files
